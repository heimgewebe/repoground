{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "heimgewebe/repoground/agent-study-receipt.v1",
  "title": "One independently bound real-run trace/usage result for RepoGround A/B/C",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "request_id",
    "request_sha256",
    "condition",
    "session_id",
    "workspace_id",
    "runner",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "usage",
    "tool_calls",
    "answer",
    "trace",
    "billed_cost",
    "resources",
    "error",
    "execution_context"
  ],
  "properties": {
    "kind": {
      "const": "repoground.agent_study_receipt"
    },
    "version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition": {
      "enum": [
        "git_only",
        "repoground_mandatory",
        "repoground_selective"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "sampling",
        "runner_version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sampling": {
          "type": "object"
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "timeout"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens"
      ],
      "properties": {
        "source": {
          "const": "provider_reported"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "name",
          "status",
          "duration_ms",
          "input_bytes",
          "output_bytes"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "failed",
              "blocked",
              "timeout"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "input_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "output_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "repoground_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "source_commit",
              "generator_commit",
              "manifest_sha256",
              "observed_status",
              "freshness"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 3
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "generator_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observed_status": {
                "const": "available"
              },
              "freshness": {
                "enum": [
                  "fresh_exact",
                  "pinned_exact"
                ]
              }
            }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reported_paths",
        "citations",
        "asserted_sufficient_evidence"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "answer",
            "abstain",
            "unavailable"
          ]
        },
        "reported_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "path"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "citations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "path",
              "commit",
              "start_line",
              "end_line"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "asserted_sufficient_evidence": {
          "type": "boolean"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "billed_cost": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "currency",
            "amount"
          ],
          "properties": {
            "source": {
              "const": "provider_billed"
            },
            "currency": {
              "enum": [
                "USD",
                "EUR"
              ]
            },
            "amount": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "resources": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_ms",
            "peak_rss_kib"
          ],
          "properties": {
            "cpu_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "peak_rss_kib": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_version",
        "host_class",
        "cache_policy",
        "tool_contract"
      ],
      "properties": {
        "agent_version": {
          "type": "string",
          "minLength": 1
        },
        "host_class": {
          "type": "string",
          "minLength": 1
        },
        "cache_policy": {
          "enum": [
            "cold",
            "warm",
            "controlled"
          ]
        },
        "tool_contract": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
