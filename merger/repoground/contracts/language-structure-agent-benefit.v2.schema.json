{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.local/schema/language-structure-agent-benefit.v2.schema.json",
  "title": "RepoGround receipt-bound language-structure agent benefit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "measurement_id",
    "source_revision",
    "goldset_sha256",
    "fallback_route",
    "candidate_route",
    "comparison",
    "treatment",
    "cases",
    "summary",
    "does_not_establish"
  ],
  "properties": {
    "kind": {"const": "repoground.language_structure_agent_benefit"},
    "version": {"const": "2.0"},
    "measurement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "goldset_sha256": {"$ref": "#/definitions/sha256"},
    "fallback_route": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_route": {"type": "string", "minLength": 1, "maxLength": 256},
    "comparison": {"$ref": "#/definitions/comparison"},
    "treatment": {"$ref": "#/definitions/treatment"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/definitions/case"}
    },
    "summary": {"$ref": "#/definitions/summary"},
    "does_not_establish": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "allOf": [
        {"contains": {"const": "default_activation"}},
        {"contains": {"const": "causal_generalization_beyond_bound_cases"}},
        {"contains": {"const": "receipt_hashes_do_not_attest_runner_or_grader_honesty"}}
      ]
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_model",
        "same_prompt",
        "same_budget",
        "same_source_revision",
        "same_grader",
        "model_identity_sha256",
        "harness_identity_sha256",
        "environment_identity_sha256",
        "grader_identity_sha256",
        "grader_rubric_sha256"
      ],
      "properties": {
        "same_model": {"const": true},
        "same_prompt": {"const": true},
        "same_budget": {"const": true},
        "same_source_revision": {"const": true},
        "same_grader": {"const": true},
        "model_identity_sha256": {"$ref": "#/definitions/sha256"},
        "harness_identity_sha256": {"$ref": "#/definitions/sha256"},
        "environment_identity_sha256": {"$ref": "#/definitions/sha256"},
        "grader_identity_sha256": {"$ref": "#/definitions/sha256"},
        "grader_rubric_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "fallback_excludes",
        "candidate_includes",
        "candidate_artifact_sha256"
      ],
      "properties": {
        "variable": {"const": "language_structure_json"},
        "fallback_excludes": {"const": true},
        "candidate_includes": {"const": true},
        "candidate_artifact_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "runner_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "source_revision",
        "goldset_sha256",
        "task_sha256",
        "route",
        "model_identity_sha256",
        "harness_identity_sha256",
        "environment_identity_sha256",
        "prompt_sha256",
        "budget_sha256",
        "control_context_sha256",
        "treatment_artifact_sha256",
        "output_sha256",
        "completed"
      ],
      "properties": {
        "kind": {"const": "repoground.language_structure_agent_run_receipt"},
        "version": {"const": "1.0"},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "goldset_sha256": {"$ref": "#/definitions/sha256"},
        "task_sha256": {"$ref": "#/definitions/sha256"},
        "route": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_identity_sha256": {"$ref": "#/definitions/sha256"},
        "harness_identity_sha256": {"$ref": "#/definitions/sha256"},
        "environment_identity_sha256": {"$ref": "#/definitions/sha256"},
        "prompt_sha256": {"$ref": "#/definitions/sha256"},
        "budget_sha256": {"$ref": "#/definitions/sha256"},
        "control_context_sha256": {"$ref": "#/definitions/sha256"},
        "treatment_artifact_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/definitions/sha256"}
          ]
        },
        "output_sha256": {"$ref": "#/definitions/sha256"},
        "completed": {"const": true}
      }
    },
    "grader_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "source_revision",
        "goldset_sha256",
        "task_sha256",
        "route",
        "runner_receipt_sha256",
        "output_sha256",
        "grader_identity_sha256",
        "grader_rubric_sha256",
        "verdict"
      ],
      "properties": {
        "kind": {"const": "repoground.language_structure_agent_grader_receipt"},
        "version": {"const": "1.0"},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "goldset_sha256": {"$ref": "#/definitions/sha256"},
        "task_sha256": {"$ref": "#/definitions/sha256"},
        "route": {"type": "string", "minLength": 1, "maxLength": 256},
        "runner_receipt_sha256": {"$ref": "#/definitions/sha256"},
        "output_sha256": {"$ref": "#/definitions/sha256"},
        "grader_identity_sha256": {"$ref": "#/definitions/sha256"},
        "grader_rubric_sha256": {"$ref": "#/definitions/sha256"},
        "verdict": {"enum": ["pass", "fail"]}
      }
    },
    "route_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "runner_receipt", "grader_receipt"],
      "properties": {
        "success": {"type": "boolean"},
        "runner_receipt": {"$ref": "#/definitions/runner_receipt"},
        "grader_receipt": {"$ref": "#/definitions/grader_receipt"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_sha256", "fallback", "candidate"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "task_sha256": {"$ref": "#/definitions/sha256"},
        "fallback": {"$ref": "#/definitions/route_result"},
        "candidate": {"$ref": "#/definitions/route_result"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "fallback_success_rate",
        "candidate_success_rate",
        "candidate_wins",
        "fallback_wins",
        "ties"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "fallback_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_wins": {"type": "integer", "minimum": 0},
        "fallback_wins": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0}
      }
    }
  }
}
