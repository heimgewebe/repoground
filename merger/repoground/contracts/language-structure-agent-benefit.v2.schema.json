{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.local/schema/language-structure-agent-benefit.v2.schema.json",
  "title": "RepoGround paired language-structure agent benefit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "measurement_id",
    "source_revision",
    "goldset_sha256",
    "fallback_route",
    "candidate_route",
    "comparison",
    "treatment",
    "cases",
    "summary",
    "does_not_establish"
  ],
  "properties": {
    "kind": {"const": "repoground.language_structure_agent_benefit"},
    "version": {"const": "2.0"},
    "measurement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "goldset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fallback_route": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate_route": {"type": "string", "minLength": 1, "maxLength": 256},
    "comparison": {"$ref": "#/definitions/comparison"},
    "treatment": {"$ref": "#/definitions/treatment"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/definitions/case"}
    },
    "summary": {"$ref": "#/definitions/summary"},
    "does_not_establish": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "allOf": [
        {"contains": {"const": "default_activation"}},
        {"contains": {"const": "causal_generalization_beyond_bound_cases"}}
      ]
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_model",
        "same_prompt",
        "same_budget",
        "same_source_revision",
        "same_grader",
        "model_identity_sha256",
        "harness_identity_sha256",
        "environment_identity_sha256",
        "grader_identity_sha256"
      ],
      "properties": {
        "same_model": {"const": true},
        "same_prompt": {"const": true},
        "same_budget": {"const": true},
        "same_source_revision": {"const": true},
        "same_grader": {"const": true},
        "model_identity_sha256": {"$ref": "#/definitions/sha256"},
        "harness_identity_sha256": {"$ref": "#/definitions/sha256"},
        "environment_identity_sha256": {"$ref": "#/definitions/sha256"},
        "grader_identity_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "fallback_excludes", "candidate_includes"],
      "properties": {
        "variable": {"const": "language_structure_json"},
        "fallback_excludes": {"const": true},
        "candidate_includes": {"const": true}
      }
    },
    "route_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "evidence_refs"],
      "properties": {
        "success": {"type": "boolean"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_sha256", "fallback", "candidate"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "task_sha256": {"$ref": "#/definitions/sha256"},
        "fallback": {"$ref": "#/definitions/route_result"},
        "candidate": {"$ref": "#/definitions/route_result"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "fallback_success_rate",
        "candidate_success_rate",
        "candidate_wins",
        "fallback_wins",
        "ties"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "fallback_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_wins": {"type": "integer", "minimum": 0},
        "fallback_wins": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0}
      }
    }
  }
}
