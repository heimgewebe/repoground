{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.local/contracts/repobrief-ask-context-pack.v1.schema.json",
  "title": "RepoBrief Ask Context Pack (repobrief-ask-context-pack v1.0)",
  "description": "Read-only context pack assembled for downstream answer generation from existing RepoBrief artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "request_id",
    "snapshot_ref",
    "freshness",
    "availability",
    "required_reading",
    "retrieval_hits",
    "resolved_ranges",
    "answer_scaffold",
    "forbidden_operations",
    "does_not_establish",
    "retrieval_infrastructure"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "repobrief.ask_context_pack"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "stem",
        "freshness_policy"
      ],
      "properties": {
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "freshness_policy": {
          "type": "string",
          "enum": [
            "use_existing_only",
            "require_fresh_or_fail",
            "allow_stale_with_caveat",
            "unknown_ok_with_caveat"
          ]
        },
        "freshness_status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "not_comparable",
            "not_applicable"
          ]
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "caveats"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown",
            "not_comparable",
            "not_applicable"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "stale_snapshot",
                  "unknown_freshness",
                  "live_state_not_checked",
                  "missing_artifact",
                  "degraded_validation",
                  "other"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "caveats"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "missing",
            "unknown"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "stale_snapshot",
                  "unknown_freshness",
                  "live_state_not_checked",
                  "missing_artifact",
                  "degraded_validation",
                  "other"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "required_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_profile",
        "required",
        "recommended",
        "missing_required",
        "missing_recommended",
        "status"
      ],
      "properties": {
        "task_profile": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_applicable"
          ]
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_query",
        "strategy",
        "match_count"
      ],
      "properties": {
        "raw_query": {
          "type": "string"
        },
        "fts_query": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "exact_and",
            "exact_and_with_structure",
            "or_relaxed",
            "or_relaxed_with_structure",
            "structure_only",
            "none"
          ]
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retrieval_infrastructure": {
      "type": "object",
      "description": "State of the search backend this pack queried, kept separate from `availability` (which describes the snapshot). Distinguishes an absent index from an index that was searched and matched nothing.",
      "additionalProperties": false,
      "required": [
        "status",
        "index_resolved"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "missing",
            "invalid",
            "unknown"
          ]
        },
        "index_resolved": {
          "type": "boolean"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retrieval_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_role",
          "ref",
          "score"
        ],
        "properties": {
          "artifact_role": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "citation_id": {
            "type": "string",
            "pattern": "^cit_[a-f0-9]{16}$"
          },
          "purpose": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": ["bash", "rust"]
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "repository_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "bundle_manifest": {
            "type": "string",
            "minLength": 1
          },
          "bundle_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_level": {
            "type": "string",
            "enum": ["S0", "S1"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uncertainty": {
            "type": "array",
            "items": {"type": "string"}
          },
          "source_range": {
            "type": "object"
          }
        }
      }
    },
    "resolved_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_role",
          "status",
          "range_ref",
          "source_authority"
        ],
        "properties": {
          "artifact_role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "missing",
              "drifted",
              "invalid",
              "degraded",
              "not_applicable"
            ]
          },
          "range_ref": {
            "type": "object"
          },
          "text_excerpt": {
            "type": "string"
          },
          "text_excerpt_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "text_excerpt_characters": {
            "type": "integer",
            "minimum": 0
          },
          "text_excerpt_truncated": {
            "type": "boolean"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_line_range": {
            "type": "object"
          },
          "citation_id": {
            "type": "string",
            "pattern": "^cit_[a-f0-9]{16}$"
          },
          "source_authority": {
            "$ref": "#/definitions/sourceAuthority"
          }
        }
      }
    },
    "answer_scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_obligations",
        "caveats_to_surface",
        "non_claims_to_surface"
      ],
      "properties": {
        "citation_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caveats_to_surface": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "stale_snapshot",
                  "unknown_freshness",
                  "live_state_not_checked",
                  "missing_artifact",
                  "degraded_validation",
                  "other"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "non_claims_to_surface": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "actual_reading_proven",
              "answer_correct",
              "repo_understood",
              "all_relevant_context_used",
              "claims_true",
              "test_sufficiency",
              "regression_absence",
              "runtime_behavior",
              "forensic_ready",
              "merge_readiness",
              "security_correctness"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "actual_reading_proven"
              }
            },
            {
              "contains": {
                "const": "answer_correct"
              }
            },
            {
              "contains": {
                "const": "repo_understood"
              }
            },
            {
              "contains": {
                "const": "all_relevant_context_used"
              }
            },
            {
              "contains": {
                "const": "claims_true"
              }
            },
            {
              "contains": {
                "const": "test_sufficiency"
              }
            },
            {
              "contains": {
                "const": "regression_absence"
              }
            },
            {
              "contains": {
                "const": "runtime_behavior"
              }
            },
            {
              "contains": {
                "const": "forensic_ready"
              }
            },
            {
              "contains": {
                "const": "merge_readiness"
              }
            },
            {
              "contains": {
                "const": "security_correctness"
              }
            }
          ],
          "description": "Non-claims downstream agents must keep visible."
        }
      }
    },
    "forbidden_operations": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "implicit_refresh",
          "git_mutation",
          "snapshot_creation_on_read",
          "patch_application",
          "pull_request_mutation",
          "shell_execution",
          "merge_authorization"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "implicit_refresh"
          }
        },
        {
          "contains": {
            "const": "git_mutation"
          }
        },
        {
          "contains": {
            "const": "snapshot_creation_on_read"
          }
        },
        {
          "contains": {
            "const": "patch_application"
          }
        },
        {
          "contains": {
            "const": "pull_request_mutation"
          }
        },
        {
          "contains": {
            "const": "shell_execution"
          }
        },
        {
          "contains": {
            "const": "merge_authorization"
          }
        }
      ],
      "description": "Operations forbidden while assembling this context pack."
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "actual_reading_proven",
          "answer_correct",
          "repo_understood",
          "all_relevant_context_used",
          "claims_true",
          "test_sufficiency",
          "regression_absence",
          "runtime_behavior",
          "forensic_ready",
          "merge_readiness",
          "security_correctness"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "actual_reading_proven"
          }
        },
        {
          "contains": {
            "const": "answer_correct"
          }
        },
        {
          "contains": {
            "const": "repo_understood"
          }
        },
        {
          "contains": {
            "const": "all_relevant_context_used"
          }
        },
        {
          "contains": {
            "const": "claims_true"
          }
        },
        {
          "contains": {
            "const": "test_sufficiency"
          }
        },
        {
          "contains": {
            "const": "regression_absence"
          }
        },
        {
          "contains": {
            "const": "runtime_behavior"
          }
        },
        {
          "contains": {
            "const": "forensic_ready"
          }
        },
        {
          "contains": {
            "const": "merge_readiness"
          }
        },
        {
          "contains": {
            "const": "security_correctness"
          }
        }
      ],
      "description": "Boundaries this context pack does not establish."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_context_tokens",
        "token_derived_byte_ceiling",
        "max_context_bytes",
        "max_answer_tokens",
        "context_bytes_used",
        "context_unicode_characters_used",
        "approx_context_chars_used",
        "byte_budget_is_hard",
        "unit",
        "accounting",
        "omissions",
        "truncated",
        "does_not_establish_quality"
      ],
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_answer_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "token_derived_byte_ceiling": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "context_bytes_used": {
          "type": "integer",
          "minimum": 0
        },
        "context_unicode_characters_used": {
          "type": "integer",
          "minimum": 0
        },
        "approx_context_chars_used": {
          "type": "integer",
          "minimum": 0
        },
        "byte_budget_is_hard": {
          "type": "boolean",
          "const": true
        },
        "unit": {
          "type": "string",
          "const": "utf8_bytes"
        },
        "accounting": {
          "type": "string",
          "minLength": 1
        },
        "omissions": {
          "type": "array",
          "items": {"type": "object"}
        },
        "truncated": {
          "type": "boolean"
        },
        "does_not_establish_quality": {
          "type": "boolean",
          "const": true
        }
      },
      "description": "Token budget report. This is a constraint record, not a quality proof."
    },
    "structured_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language_structure": {
          "type": "object",
          "description": "Budgeted optional Rust/Bash navigation evidence with language-specific uncertainty and provenance."
        }
      }
    }
  },
  "definitions": {
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "frontmatter_present",
        "establishes_current_state",
        "does_not_establish"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "unclassified",
            "current_candidate",
            "historical_only",
            "point_in_time_observation"
          ]
        },
        "frontmatter_present": {
          "type": "boolean"
        },
        "establishes_current_state": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "does_not_establish": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "canonicality": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "temporal_scope": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "unclassified",
                  "current_candidate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "establishes_current_state": {
                "type": "null"
              },
              "does_not_establish": {
                "contains": {
                  "const": "current_state_without_fresh_verification"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "historical_only",
                  "point_in_time_observation"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "establishes_current_state": {
                "const": false
              },
              "does_not_establish": {
                "allOf": [
                  {
                    "contains": {
                      "const": "current_state"
                    }
                  },
                  {
                    "contains": {
                      "const": "current_architecture"
                    }
                  },
                  {
                    "contains": {
                      "const": "current_service_necessity"
                    }
                  },
                  {
                    "contains": {
                      "const": "preferred_access_path"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "description": "Lifecycle consistency: unclassified authority has no parsed frontmatter lifecycle fields.",
          "if": {
            "required": [
              "classification"
            ],
            "properties": {
              "classification": {
                "const": "unclassified"
              }
            }
          },
          "then": {
            "properties": {
              "frontmatter_present": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {"required": ["status"]},
                {"required": ["canonicality"]},
                {"required": ["role"]},
                {"required": ["temporal_scope"]},
                {"required": ["observed_at"]},
                {"required": ["last_reviewed"]}
              ]
            }
          }
        },
        {
          "description": "Lifecycle consistency: current candidates cannot carry lifecycle markers that derive a non-current classification.",
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {"const": "current_candidate"}
            }
          },
          "then": {
            "properties": {
              "frontmatter_present": {"const": true}
            },
            "not": {
              "anyOf": [
                {
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "pattern": "^\\s*([dD][eE][pP][rR][eE][cC][aA][tT][eE][dD]|[hH][iI][sS][tT][oO][rR][iI][cC][aA][lL]|[sS][uU][pP][eE][rR][sS][eE][dD][eE][dD]|[rR][eE][tT][iI][rR][eE][dD]|[aA][rR][cC][hH][iI][vV][eE][dD])\\s*$"
                    }
                  }
                },
                {
                  "required": ["canonicality"],
                  "properties": {
                    "canonicality": {
                      "pattern": "^\\s*([dD][eE][pP][rR][eE][cC][aA][tT][eE][dD]|[hH][iI][sS][tT][oO][rR][iI][cC][aA][lL]|[sS][uU][pP][eE][rR][sS][eE][dD][eE][dD])\\s*$"
                    }
                  }
                },
                {
                  "required": ["canonicality"],
                  "properties": {
                    "canonicality": {
                      "pattern": "^\\s*([oO][bB][sS][eE][rR][vV][aA][tT][iI][oO][nN])\\s*$"
                    }
                  }
                },
                {
                  "required": ["temporal_scope"],
                  "properties": {
                    "temporal_scope": {
                      "pattern": "^\\s*([pP][oO][iI][nN][tT]_[iI][nN]_[tT][iI][mM][eE])\\s*$"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "description": "Lifecycle consistency: historical authority requires the same historical status/canonicality evidence used by the runtime classifier.",
          "if": {
            "required": ["classification"],
            "properties": {
              "classification": {"const": "historical_only"}
            }
          },
          "then": {
            "properties": {
              "frontmatter_present": {"const": true}
            },
            "anyOf": [
              {
                "required": ["status"],
                "properties": {
                  "status": {
                    "pattern": "^\\s*([dD][eE][pP][rR][eE][cC][aA][tT][eE][dD]|[hH][iI][sS][tT][oO][rR][iI][cC][aA][lL]|[sS][uU][pP][eE][rR][sS][eE][dD][eE][dD]|[rR][eE][tT][iI][rR][eE][dD]|[aA][rR][cC][hH][iI][vV][eE][dD])\\s*$"
                  }
                }
              },
              {
                "required": ["canonicality"],
                "properties": {
                  "canonicality": {
                    "pattern": "^\\s*([dD][eE][pP][rR][eE][cC][aA][tT][eE][dD]|[hH][iI][sS][tT][oO][rR][iI][cC][aA][lL]|[sS][uU][pP][eE][rR][sS][eE][dD][eE][dD])\\s*$"
                  }
                }
              }
            ]
          }
        },
        {
          "description": "Lifecycle consistency: point-in-time authority requires observation/point-in-time evidence and no higher-precedence historical marker.",
          "if": {
            "required": ["classification"],
