{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.local/schema/language-structure-goldset.v1.schema.json",
  "title": "RepoGround language-structure goldset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "description", "cases", "does_not_establish"],
  "properties": {
    "kind": {"const": "repoground.language_structure_goldset"},
    "version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "language", "size_class", "case_class", "fixture_root", "expected_records", "expected_degradation_reasons"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "language": {"enum": ["bash", "rust"]},
          "size_class": {"enum": ["small", "medium", "large"]},
          "case_class": {"enum": ["positive", "ambiguous", "dynamic", "null"]},
          "fixture_root": {"type": "string", "minLength": 1},
          "expected_records": {
            "type": "array",
            "items": {"$ref": "#/definitions/expected_record"}
          },
          "expected_degradation_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "definitions": {
    "expected_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "relation", "symbol", "target_symbol", "path", "start_line", "end_line", "start_character", "end_character"],
      "properties": {
        "language": {"enum": ["bash", "rust"]},
        "relation": {"enum": ["definition", "call", "dependency", "reference"]},
        "symbol": {"type": "string", "minLength": 1},
        "target_symbol": {"type": ["string", "null"]},
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_character": {"type": "integer", "minimum": 0},
        "end_character": {"type": "integer", "minimum": 1}
      }
    }
  }
}
