#!/usr/bin/env bash
set -euo pipefail

REPOGROUND_MANAGED_ROOT="$HOME/.local/share/repoground-runtime/current"
REPOGROUND_MANAGED_PYTHON="$REPOGROUND_MANAGED_ROOT/.venv/bin/python"
REPOGROUND_ROOT_EXPLICIT=0
REPOGROUND_PYTHON_EXPLICIT=0
[[ -n ${REPOGROUND_ROOT:-} ]] && REPOGROUND_ROOT_EXPLICIT=1
[[ -n ${REPOGROUND_PYTHON:-} ]] && REPOGROUND_PYTHON_EXPLICIT=1

if [[ $REPOGROUND_ROOT_EXPLICIT -eq 0 && $REPOGROUND_PYTHON_EXPLICIT -eq 0 ]]; then
  if [[ -e "$REPOGROUND_MANAGED_ROOT" || -L "$REPOGROUND_MANAGED_ROOT" ]]; then
    if [[ ! -x "$REPOGROUND_MANAGED_PYTHON" ]]; then
      printf 'repoground: managed runtime activation exists but Python is unavailable: %s\n' "$REPOGROUND_MANAGED_PYTHON" >&2
      exit 1
    fi
    REPOGROUND_ROOT="$REPOGROUND_MANAGED_ROOT"
    REPOGROUND_PYTHON="$REPOGROUND_MANAGED_PYTHON"
    REPOGROUND_USE_USER_SITE=0
  else
    REPOGROUND_ROOT="$HOME/repos/repoground"
    REPOGROUND_PYTHON=python3
    REPOGROUND_USE_USER_SITE=1
  fi
else
  REPOGROUND_ROOT="${REPOGROUND_ROOT:-$HOME/repos/repoground}"
  REPOGROUND_PYTHON="${REPOGROUND_PYTHON:-python3}"
  REPOGROUND_USE_USER_SITE=1
fi

if [[ ! -f "$REPOGROUND_ROOT/repoground/__main__.py" ]]; then
  printf 'repoground: canonical source checkout unavailable: %s\n' "$REPOGROUND_ROOT" >&2
  exit 1
fi

exec "$REPOGROUND_PYTHON" -I -c '
import os
import site
import sys

root = os.path.realpath(sys.argv[1])
use_user_site = sys.argv[2] == "1"
sys.path.insert(0, root)
if use_user_site:
    user_site = site.getusersitepackages()
    if isinstance(user_site, str) and user_site and user_site not in sys.path:
        sys.path.insert(1, user_site)

from repoground.cli import main
raise SystemExit(main(sys.argv[3:]))
' "$REPOGROUND_ROOT" "$REPOGROUND_USE_USER_SITE" "$@"
